# =============================================================
#  scb_monitor_web - DB 선택 / 자동 교체 설정 (conf/scb-db.properties)
#  - 웹을 다시 시작하면 적용 (관리자 화면 [시스템관리 > DB 연결 관리] 에서 저장해도 이 파일이 바뀜)
#  - 값을 비워 두면 기존 설정을 씀 : conf/scb_web.env 의 SCB_DB, MYSQL_*, SCB_ORACLE_*, SYBASE_* 환경변수
#  - 비밀번호는 관리자 화면에서 입력하면 ENC(...) 로 암호화되어 저장됨 (키 : 같은 폴더 scb-db.key, 지우면 다시 입력)
#    파일에 평문으로 직접 적는 것은 권장하지 않음
# =============================================================

# 주 DB : auto   = 아래 우선순위(db.order)에서 연결되는 첫 DB
#         oracle | sybase | mysql | mariadb | h2 = 그 DB 로 시작 (연결 안 되면 db.failover=true 일 때 다음 순위로)
db.primary=auto

# 주 DB 연결이 끊기면 다음 순위 DB 로 자동 교체 (true / false)
# 위 순위 DB 가 다시 살아나도 자동으로 되돌아가지 않음 - 관리자 화면에서 [이 DB 로 전환]
db.failover=true

# 우선순위 (앞이 높음)
db.order=oracle,sybase,mysql,mariadb,h2

# 주 DB 연결 확인 주기(초) / 연결 확인 제한 시간(ms)
db.health-interval-sec=15
db.probe-timeout-ms=3000

# ---- Oracle (12c 이상, ojdbc8) : 처음 연결할 때 테이블이 없으면 자동 생성
db.oracle.enabled=
db.oracle.url=
db.oracle.username=
db.oracle.password=

# ---- Sybase ASE (15 이상, jTDS) : 처음 연결할 때 테이블이 없으면 자동 생성
#      예) jdbc:jtds:sybase://10.0.0.30:5000/scbmon;charset=utf8;useLOBs=false
#      SAP jConnect 를 쓰려면 jconn4.jar 를 넣고 driver=com.sybase.jdbc4.jdbc.SybDriver , url=jdbc:sybase:Tds:호스트:5000/scbmon
db.sybase.enabled=
db.sybase.url=
db.sybase.username=
db.sybase.password=
db.sybase.driver=

# ---- MySQL 8.x (스키마 scb_mon_agent)
db.mysql.enabled=
db.mysql.url=
db.mysql.username=
db.mysql.password=

# ---- MariaDB : embedded=true 면 웹이 직접 띄우는 MariaDB (mariadb 폴더, 127.0.0.1:13307), false 면 아래 url
db.mariadb.enabled=
db.mariadb.embedded=
db.mariadb.url=
db.mariadb.username=
db.mariadb.password=

# ---- H2 : url 을 비우면 실행 폴더의 data/h2 파일 DB (Windows · Solaris 공통)
db.h2.enabled=
db.h2.url=
db.h2.username=
db.h2.password=
