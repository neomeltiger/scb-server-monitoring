# client.env - krcasmrx11_client 설정 (Bourne shell 문법)
#   처음 설치 시 : cp etc/client.env.sample etc/client.env  후 아래 값을 바꾸세요.
#
# 1) 웹 화면 네트워크 구성도 → 서버 선택 → [에이전트 토큰 발급] 을 누르면
#    아래 두 줄(SCB_WEB_URL, SCB_AGENT_TOKEN)이 표시됩니다. 그대로 바꿔 넣으세요.
# 2) 토큰은 비밀번호처럼 다루세요. 이 파일 권한은 root 만 읽을 수 있게(600) 두는 것을 권장합니다.
SCB_WEB_URL=http://웹서버주소:8080/server-monitoring-web
SCB_AGENT_TOKEN=

# krcasmrx11_agent 위치 (scb_main.sh status / 제어 명령 실행에 사용)
SCB_AGENT_HOME=/shared/opt/agent/krcasmrx11_agent

# 웹 서버가 요청할 수 있는 로그 파일 (공백 구분 셸 패턴). 이 목록 밖의 경로는 웹에서 등록해도 읽지 않습니다.
# 비우면 기본값 : /var/adm/messages /var/adm/messages.[0-9]* /var/log/*.log /var/log/syslog
#                 /shared/opt/agent/krcasmrx11_agent/log/* /shared/opt/agent/krcasmrx11_client/log/*
#SCB_LOG_ALLOW="/var/adm/messages /shared/opt/agent/krcasmrx11_agent/log/*"

# HTTP 요청 제한 시간(초), 자체 서명 인증서(https) 허용 여부(1 = 검사 안 함)
SCB_HTTP_TIMEOUT=20
SCB_HTTP_INSECURE=0
